rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 이 구현은 Firebase Auth를 사용하지 않으므로 (request.auth == null)
    // Firestore Rules 레벨에서 일반 방문자와 관리자를 안전하게 구별할 수 없습니다.
    // 기능을 동작하게 하기 위해 임시로 읽기/쓰기를 허용하지만,
    // 프로덕션에 배포하기 전에 반드시 적절한 관리자 인증(Firebase Auth)과 권한(Rules) 설정이 필요합니다.

    match /admins/{uid} {
      allow read: if false;
      allow write: if false; 
    }

    match /participants/{participantId} {
      allow read, write: if true; 
    }

    match /inspectionLogs/{logId} {
      allow read, write: if true; 
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /reservations/{resId} {
      // 일반 예약 생성을 위해 필요
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'status', 'queueSequence']);
      
      // 관리자 화면 조회를 위해 열어두었으나, 악용 시 모든 사람의 예약(전화번호)이 노출됩니다.
      allow read, update, delete: if true;
    }

    match /publicQueueStats/current {
      allow read, write: if true; 
    }

    match /commonQuestions/{questionId} {
      allow read, write: if true; 
    }

    match /system/{docId} {
      // 예약 트랜잭션을 위해 카운터 업데이트 허용 (보안 취약)
      allow read, write: if true;
    }
  }
}
