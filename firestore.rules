rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only manageable via console/admin SDK
    }

    match /participants/{participantId} {
      allow read: if isAdmin();
      allow write: if false; // Trusted backend only
    }

    match /participantResults/{participantId} {
      allow read: if true; // Public access for results
      allow write: if false; // Trusted backend only
    }

    match /inspectionLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Trusted backend only
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Trusted backend only
    }

    match /reservations/{resId} {
      allow read: if isAdmin();
      allow write: if false; // Trusted backend only
    }

    match /publicQueueStats/current {
      allow read: if true; // Public access
      allow write: if false; // Trusted backend only
    }

    match /commonQuestions/{questionId} {
      allow read: if true; // Public can see the questions being asked
      allow write: if isAdmin(); // Admin can manage common questions directly
    }

    match /system/{docId} {
      allow read, write: if false; // Trusted backend only
    }
  }
}
